# Clave de Flask. Genera una distinta para tu instalación.
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# Servidor e instancia. Ejemplos: localhost, .\SQLEXPRESS, EQUIPO\MSSQLSERVER
DB_SERVER=localhost
DB_NAME=Northwind

# Autenticación: windows o sql
DB_AUTH=windows

# Solo se usan cuando DB_AUTH=sql
DB_USER=
DB_PASSWORD=

# Debe coincidir con un controlador instalado en Windows.
DB_DRIVER=ODBC Driver 17 for SQL Server

# Opciones recomendadas para desarrollo local.
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes
DB_TIMEOUT=5

FLASK_PORT=5000
FLASK_DEBUG=1
